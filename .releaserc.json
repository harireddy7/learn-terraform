{
  "branches": [
    {
      "name": "dev",
      "prerelease": true
    },
    {
      "name": "release/alpha-*",
      "prerelease": "alpha"
    },
    {
      "name": "main"
    }
  ],
  "plugins": [
    [
      "@semantic-release/commit-analyzer",
      {
        "preset": "conventionalcommits",
        "releaseRules": [
          {
            "type": "feat",
            "release": "minor"
          },
          {
            "type": "fix",
            "release": "patch"
          }
        ]
      }
    ],
    "@semantic-release/release-notes-generator",
    [
      "@semantic-release/github",
      {
        "successCommentCondition": false,
        "failComment": false
      }
    ]
  ]
}